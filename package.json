{
  "name": "ceybyte-com",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @cbpos/api --filter @cbpos/web dev",
    "build:content": "bun run --filter @cbpos/web build:content",
    "build": "bun run --filter @cbpos/web build",
    "preview": "bun run build && bun run --filter @cbpos/api dev",
    "deploy": "bun run --filter @cbpos/api --filter @cbpos/www-redirect deploy",
    "cf-typegen": "bun run --filter @cbpos/api cf-typegen",
    "db:generate": "bun run --filter @cbpos/api db:generate",
    "db:migrate:local": "bun run --filter @cbpos/api db:migrate:local",
    "db:migrate:remote": "bun run --filter @cbpos/api db:migrate:remote",
    "db:seed:local": "bun scripts/seed.ts",
    "db:studio": "bun run --filter @cbpos/api db:studio",
    "lint": "bun run --filter '*' lint && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "i18n:check": "bun scripts/i18n-check.ts",
    "check:claims": "bun run scripts/banned-claims-check.ts",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "bun-types": "^1.4.3",
    "drizzle-kit": "^0.31",
    "eslint": "^9",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "typescript": "^5",
    "typescript-eslint": "^8.72.0"
  },
  "packageManager": "bun@1.3.5",
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "@orama/plugin-data-persistence": "^3.1.18",
    "@resvg/resvg-js": "^2.6.2",
    "satori": "^0.63.2"
  }
}
