# Local development values for branch `main`. Copy to .env and adjust.
# Production values live only in Dokploy. Never commit a real .env.
# Full list and purpose: docs/02-TRD.md §2.4

SITE_URL=http://localhost:3000
CDN_URL=http://localhost:3902
LOCALES_ENABLED=en,si,ta

# PostgreSQL (compose.dev.yml)
DATABASE_URL=postgres://cbpos:cbpos@localhost:5432/cbpos
MIGRATION_DATABASE_URL=postgres://cbpos_migrator:cbpos@localhost:5432/cbpos
DB_POOL_MAX=10

# Valkey
VALKEY_URL=redis://localhost:6379

# Garage (S3-compatible). Keys are created by the dev init script.
S3_ENDPOINT=http://localhost:3900
S3_PUBLIC_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Auth
BETTER_AUTH_SECRET=change-me-to-32-random-bytes
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=

# Cloudflare Turnstile test keys (always pass)
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Releases
RELEASES_REPO=ceybyte/cbpos-releases
RELEASE_MANIFEST_URL=https://raw.githubusercontent.com/ceybyte/cbpos-releases/main/latest.json
GITHUB_WEBHOOK_SECRET=dev-webhook-secret
GITHUB_API_TOKEN=

# Hashing and internal calls
IP_HASH_PEPPER=dev-pepper
CLAIM_TOKEN_SECRET=dev-claim-secret
INTERNAL_SECRET=dev-internal-secret

# Analytics (leave empty to disable locally)
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Community
WHATSAPP_COMMUNITY_URL=https://chat.whatsapp.com/BS73D23VD74BbseKuoC1BM

# Donations: bank details pending (F-11 can't launch until set)
DONATION_BANK_NAME=
DONATION_BANK_BRANCH=
DONATION_ACCOUNT_NAME=
DONATION_ACCOUNT_NUMBER=
