# Local secrets for `wrangler dev` and tests. Copy to .dev.vars (gitignored). Production values are
# Worker secrets (`wrangler secret put NAME`), never committed. Names: docs/02-TRD.md §2.3.
ENVIRONMENT=development
# The web dev server proxies /api here, so auth links and cookies use its origin.
SITE_URL=http://localhost:3000

BETTER_AUTH_SECRET=change-me-32-random-bytes-base64
# Optional locally. Without them Google sign-in is off and OTP codes are written to the dev log.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=

# Cloudflare's always-pass test secret (https://developers.cloudflare.com/turnstile/troubleshooting/testing/)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# S3 API token scoped to cbpos-uploads (Object Read & Write). Needed only to test presigned uploads.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

GITHUB_WEBHOOK_SECRET=change-me
GITHUB_DISPATCH_TOKEN=
GITHUB_API_TOKEN=

IP_HASH_PEPPER=change-me
CLAIM_TOKEN_SECRET=change-me
