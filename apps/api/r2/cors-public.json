{
  "rules": [
    {
      "allowed": {
        "origins": ["https://ceybyte.com", "http://localhost:3000", "http://localhost:8787"],
        "methods": ["GET", "HEAD"],
        "headers": ["range", "if-match", "if-none-match"]
      },
      "exposeHeaders": ["etag", "content-length", "content-range", "accept-ranges"],
      "maxAgeSeconds": 86400
    }
  ]
}
