{
  "name": "@cbpos/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun --bun next dev --port 3000",
    "build:content": "bun ../../scripts/build-content.ts",
    "build:search": "bun ../../scripts/build-search.ts",
    "build:og": "bun ../../scripts/generate-og.ts",
    "build:map-teaser": "bun ../../scripts/map-teaser.ts",
    "build": "bun run build:content && bun run build:search && bun run build:og && bun run build:map-teaser && bun --bun next build && rm -rf out/styleguide && cp public/404.html out/404.html",
    "lint": "eslint .",
    "typecheck": "bun run build:content --if-missing && tsc --noEmit",
    "test": "bun run build:content --if-missing && bun test src"
  },
  "dependencies": {
    "@cbpos/shared": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-sinhala": "^5.3.0",
    "@fontsource-variable/noto-sans-tamil": "^5.3.0",
    "@lucasmarkes/hairline": "^0.5.1",
    "@orama/orama": "^3.1.18",
    "@orama/plugin-data-persistence": "^3.1.18",
    "@protomaps/basemaps": "^5.7.2",
    "better-auth": "^1.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "geist": "^1.9.1",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "lucide-react": "^1.70.0",
    "maplibre-gl": "^6.16.0",
    "motion": "^14.9.1",
    "next": "15.5.29",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "pmtiles": "^4.5.0",
    "posthog-js": "^1.447.2",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@tailwindcss/postcss": "^4",
    "tailwindcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "@eslint/eslintrc": "^3"
  }
}
